# ---- brain -------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
GROK_MODEL=x-ai/grok-4.6

# ---- loop --------------------------------------------------------------
# Seconds to WAIT between research steps. 0 means start the next one as soon as
# the last finishes — which is the usual setting, because grok-4.6 already takes
# 1-8 minutes per call and a deliberate gap on top of that just idles the loop.
# DAILY_BUDGET_USD is the real throttle, not this.
STEP_SECONDS=0

# Spend guard, USD per day. Not a pacing tool — the loop never slows down to
# stay under it, it simply stops when it crosses it and says so on the site.
# Keep it set even if it is generous: it is the only thing standing between a
# bug that fires calls in a tight loop and an unbounded bill.
DAILY_BUDGET_USD=20.00

# ---- site --------------------------------------------------------------
PORT=4300

